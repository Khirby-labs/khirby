{
  "name": "khirby",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "start": "concurrently -n api,web -c cyan,magenta \"pnpm --filter api start\" \"pnpm --filter web preview\"",
    "start:api": "pnpm --filter api start",
    "start:web": "pnpm --filter web preview",
    "test": "pnpm --filter api test",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "test:web:coverage": "pnpm --filter web test:coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "lint:design": "node scripts/design-guard.mjs",
    "lint:i18n": "node scripts/i18n-guard.mjs",
    "typecheck:web": "pnpm --filter web typecheck",
    "build:forms-client": "pnpm --filter @khirby/forms-client build",
    "build:forms-ui": "pnpm --filter @khirby/forms-ui build",
    "build:payload-forms": "pnpm --filter @khirby/payload-forms build",
    "test:forms-client": "pnpm --filter @khirby/forms-client test",
    "test:forms-ui": "pnpm --filter @khirby/forms-ui test",
    "test:watch": "pnpm --filter api test:watch",
    "migrate": "pnpm --filter api migrate",
    "db:generate": "pnpm --filter api db:generate",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:plugins": "node scripts/sync-plugins.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:design && pnpm lint:i18n && pnpm test && pnpm test:web && pnpm test:forms-client && pnpm test:forms-ui",
    "docker:up": "docker compose -f docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "start:db": "docker compose -f docker/docker-compose.dev.yml up -d",
    "stop:db": "docker compose -f docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0"
  }
}
