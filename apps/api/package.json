{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "predev": "node ../../scripts/sync-plugins.mjs",
    "prebuild": "node ../../scripts/sync-plugins.mjs",
    "build": "nest build",
    "start": "node dist/apps/api/src/main",
    "migrate": "ts-node -r dotenv/config src/migrate.ts dotenv_config_path=../../.env",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^10.1.3",
    "@khirby/forms-client": "workspace:*",
    "@khirby/plugin-ai-compose": "^1.1.0",
    "@khirby/plugin-discord": "^1.0.0",
    "@khirby/plugin-host": "workspace:*",
    "@khirby/plugin-listmonk": "^1.1.0",
    "@khirby/plugin-mcp": "^1.1.0",
    "@khirby/plugin-pokelo": "^1.0.0",
    "@khirby/plugin-sdk": "workspace:*",
    "@khirby/plugin-webhook": "^1.0.0",
    "@khirby/types": "workspace:*",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "connect-redis": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "hono": "4.13.1",
    "imapflow": "^1.6.3",
    "ioredis": "^5.11.1",
    "jiti": "^2.7.0",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ts-node": "^10.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.0",
    "@types/redis": "^4.0.11",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest-setup.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@khirby/types$": "<rootDir>/../../../packages/types/src",
      "^@khirby/plugin-sdk$": "<rootDir>/../../../packages/plugin-sdk/src",
      "^@khirby/plugin-host$": "<rootDir>/../../../packages/plugin-host/src",
      "^@khirby/plugin-host/(.*)$": "<rootDir>/../../../packages/plugin-host/src/$1",
      "^@khirby/forms-client$": "<rootDir>/../../../packages/forms-client/src"
    },
    "roots": [
      "<rootDir>",
      "<rootDir>/../../../plugins",
      "<rootDir>/../../../examples"
    ]
  }
}
